+    fn enabled() -> bool { static ON: OnceLock<bool> = OnceLock::new(); *ON.get_or_init(|| std::env::var_os("TERMINAL_FONTDB_PROFILE").is_some_and(|v| v == "1")) }
+    pub fn reset() { if enabled() { COSTS.with(|c| *c.borrow_mut() = [(0,0);10]); } }
