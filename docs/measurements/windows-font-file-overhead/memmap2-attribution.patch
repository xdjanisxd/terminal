+    pub fn timer(i: usize) -> Timer { Timer(i, enabled().then(Instant::now)) }
+    impl Drop for Timer { fn drop(&mut self) { if let Some(t)=self.1 { COSTS.with(|c| { let mut c=c.borrow_mut(); c[self.0].0 += t.elapsed().as_nanos() as u64; c[self.0].1 += 1; }); } } }
+    pub fn report() -> String { let mut s=String::new(); COSTS.with(|c| { for (name,(ns,count)) in ["probe-write","probe-exec","create-mapping","map-view","close-mapping","duplicate-handle","unmap-view","close-duplicate","file-length","virtual-protect"].iter().zip(c.borrow().iter()) { let _=writeln!(s,"memmap-profile stage={name} duration_us={} count={count}",ns/1000); } }); s }
+}
 
