+// Temporary Windows startup attribution only. No behavior changes.
+#[cfg(target_os = "windows")]
+mod startup_profile {
+    use std::{cell::RefCell, sync::OnceLock, time::Instant};
+    thread_local! { static COSTS: RefCell<[(u64, u64); 8]> = const { RefCell::new([(0, 0); 8]) }; }
+    fn enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var_os("TERMINAL_FONTDB_PROFILE").is_some_and(|v| v == "1"))
+    }
+    pub struct Timer(usize, Option<Instant>);
+    pub fn timer(index: usize) -> Timer { Timer(index, enabled().then(Instant::now)) }
+    impl Drop for Timer {
+        fn drop(&mut self) {
+            if let Some(start) = self.1 {
+                COSTS.with(|c| { let mut c = c.borrow_mut(); c[self.0].0 += start.elapsed().as_nanos() as u64; c[self.0].1 += 1; });
+            }
+        }
+    }
+    pub struct Discovery(Option<Instant>);
+    pub fn discovery() -> Discovery {
+        if enabled() { COSTS.with(|c| *c.borrow_mut() = [(0,0);8]); }
+        Discovery(enabled().then(Instant::now))
+    }
+    impl Drop for Discovery {
+        fn drop(&mut self) {
+            if let Some(start) = self.0 {
+                let total = start.elapsed().as_micros();
+                COSTS.with(|c| {
+                    use std::fmt::Write;
+                    let mut report = String::new();
+                    let _ = writeln!(report, "fontdb-profile stage=discovery duration_us={total} count=1");
+                    for (name, (ns,count)) in ["file-open-map", "face-metadata-parse", "file-total", "entry-type-canonicalize", "read-dir-open", "file-unmap-close", "file-open", "file-map"].iter().zip(c.borrow().iter()) {
+                        let _ = writeln!(report, "fontdb-profile stage={name} duration_us={} count={count}", ns / 1000);
+                    }
+                    if let Some(path) = std::env::var_os("TERMINAL_STARTUP_LOG") {
+                        let _ = std::fs::write(std::path::PathBuf::from(path).with_extension("fontdb"), report);
+                    }
+                });
+            }
+        }
     }
 }
 
